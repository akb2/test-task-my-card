{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "rootDir": "src",
    "outDir": ".dist",
    "paths": {
      "@root/*": [
        "./src/*"
      ],
      "@data/*": [
        "./src/data/*"
      ],
      "@controllers/*": [
        "./src/controllers/*"
      ],
      "@modules/*": [
        "./src/modules/*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}